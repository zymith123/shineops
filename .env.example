# Postgres connection string. Locally: postgres://user:pass@localhost:5432/shineops
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=

# Random string, 32+ characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Enables Claude-powered call analysis and health scoring; without it
# keyword rules are used (no coaching scores).
ANTHROPIC_API_KEY=

# Optional. Model for all AI features. Default: claude-haiku-4-5 (fractions of a
# cent per call). Use claude-sonnet-5 or claude-opus-5 for more nuanced analysis.
ANTHROPIC_MODEL=
