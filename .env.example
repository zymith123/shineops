# Postgres connection string. Locally: postgres://user:pass@localhost:5432/shineops
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=

# Random string, 32+ characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Enables Claude-powered health analysis; without it the rules engine is used.
ANTHROPIC_API_KEY=
